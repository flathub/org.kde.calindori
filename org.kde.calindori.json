{
    "id": "org.kde.calindori",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "calindori",
    "rename-icon": "calindori",
    "rename-appdata-file": "org.kde.calindori.appdata.xml",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--share=network"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "kpeople",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/frameworks/6.24/kpeople-6.24.0.tar.xz",
                    "sha256": "d3e267753eb64c3bbba8e4af4a4503695ee62d015b30c2dad1a1f1343890fea4",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8762,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/frameworks/$major.$minor/kpeople-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "org.kde.calindori",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.04.0/src/calindori-26.04.0.tar.xz",
                    "sha256": "bcd7dff8b5325ff0d05535f2a3ca5447b76658f8a73bd2b40c39ee15aaa222e2",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/calindori-$version.tar.xz"
                    }
                },
                {
                    "type": "patch",
                    "path": "appdata-homepage.patch"
                }
            ]
        }
    ]
}
