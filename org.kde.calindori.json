{
    "id": "org.kde.calindori",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "calindori",
    "rename-icon": "calindori",
    "rename-appdata-file": "org.kde.calindori.appdata.xml",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--share=network"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "kpeople",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/frameworks/6.29/kpeople-6.29.0.tar.xz",
                    "sha256": "cb8900532f6c1ba6a4711b3d98e4d2b1c23bf2deb5588262f35554344fe574ca",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8762,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/frameworks/$major.$minor/kpeople-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "org.kde.calindori",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/calindori-26.08.0.tar.xz",
                    "sha256": "5ebae3bab1ab5b95296b664a08b21bba72627fbed0d0cdd3edfba83ff233f645",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/calindori-$version.tar.xz"
                    }
                },
                {
                    "type": "patch",
                    "path": "appdata-homepage.patch"
                }
            ]
        }
    ]
}
